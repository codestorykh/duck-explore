#!/bin/sh
# .githooks/pre-push

# Navigate to the repository root directory
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

echo "🚀 [PRE-PUSH GATE] Verifying system architecture rules..."

# Determine whether to use wrapper or global mvn
if [ -f "./mvnw" ]; then
    MAVEN_CMD="./mvnw"
elif [ -f "./mvnw.cmd" ]; then
    MAVEN_CMD="./mvnw.cmd"
else
    MAVEN_CMD="mvn"
fi

$MAVEN_CMD test -Dtest="*Architecture*"
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "❌ [PUSH ABORTED] Architectural boundaries were violated!"
    echo "   👉 Review the class dependencies listed above and refactor before pushing."
    exit 1
fi

echo "✅ Architectural integrity verified. Pushing..."
exit 0