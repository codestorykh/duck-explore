#!/bin/sh
# .githooks/pre-push

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

echo "🚀 [PRE-PUSH GATE] Compiling and verifying architecture rules..."

# Use wrapper if present, otherwise global mvn
if [ -f "./mvnw" ]; then
    CMD="./mvnw"
elif [ -f "./mvnw.cmd" ]; then
    CMD="./mvnw.cmd"
else
    CMD="mvn"
fi

# Compile production classes only, then execute the runner
$CMD compile exec:java -Dexec.mainClass="com.duck.explore.architecture.ArchitectureVerificationRunner" -q
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "❌ [PUSH ABORTED] Architectural boundaries were violated!"
    echo "   👉 Review the class dependencies listed above and refactor before pushing."
    exit 1
fi

echo "✅ Architectural integrity verified. Pushing..."
exit 0