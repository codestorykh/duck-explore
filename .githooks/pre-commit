#!/usr/bin/env bash
set -e

# Always ensure the script executes from the repository root
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

# 1. Resolve Java 21 for macOS / Linux / SDKMAN
CURRENT_JAVA_VER=$(java -version 2>&1 | head -n 1 || true)

if [[ -z "$JAVA_HOME" ]] || [[ "$CURRENT_JAVA_VER" != *"21"* ]]; then
    # macOS native JVM discovery (/usr/libexec/java_home)
    if [ -x "/usr/libexec/java_home" ]; then
        DETECTED_JAVA=$(/usr/libexec/java_home -v 21 2>/dev/null || true)
        if [ -n "$DETECTED_JAVA" ]; then
            export JAVA_HOME="$DETECTED_JAVA"
        fi
    fi

    # Fallback to SDKMAN on macOS (~/.sdkman)
    if [ -z "$JAVA_HOME" ] && [ -d "$HOME/.sdkman/candidates/java" ]; then
        SDKMAN_21=$(find "$HOME/.sdkman/candidates/java" -maxdepth 1 -name "21*" | head -n 1 || true)
        if [ -n "$SDKMAN_21" ]; then
            export JAVA_HOME="$SDKMAN_21"
        fi
    fi

    # Fallback to Homebrew OpenJDK paths on macOS (Apple Silicon / Intel)
    if [ -z "$JAVA_HOME" ]; then
        if [ -d "/opt/homebrew/opt/openjdk@21" ]; then
            export JAVA_HOME="/opt/homebrew/opt/openjdk@21"
        elif [ -d "/usr/local/opt/openjdk@21" ]; then
            export JAVA_HOME="/usr/local/opt/openjdk@21"
        elif [ -d "/usr/lib/jvm/java-21-openjdk" ]; then
            export JAVA_HOME="/usr/lib/jvm/java-21-openjdk"
        fi
    fi
fi

# Prepend JAVA_HOME/bin to PATH so mvn and child subshells use Java 21
if [ -n "$JAVA_HOME" ] && [ -d "$JAVA_HOME/bin" ]; then
    export PATH="$JAVA_HOME/bin:$PATH"
fi

# 2. Identify staged .java files
STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.java$' || true)

if [ -z "$STAGED_JAVA_FILES" ]; then
    exit 0
fi

echo "======================================================="
echo "🔍 [PRE-COMMIT] Validating null-safety via NullAway..."
echo "ℹ️  Using Java: $(java -version 2>&1 | head -n 1)"
echo "======================================================="

# 3. Resolve Maven command
if [ -f "./mvnw" ]; then
    MVN_CMD="./mvnw"
elif command -v mvn >/dev/null 2>&1; then
    MVN_CMD="mvn"
else
    echo "❌ Error: Neither ./mvnw nor system 'mvn' found in PATH."
    exit 1
fi

# 4. Stash unstaged changes to only compile staged files
STASH_NAME="pre-commit-nullcheck-$(date +%s)"
HAS_UNSTAGED=$(git diff --name-only)

if [ -n "$HAS_UNSTAGED" ]; then
    git stash push -q --keep-index -m "$STASH_NAME"
fi

restore_stash() {
    if [ -n "$HAS_UNSTAGED" ]; then
        STASH_INDEX=$(git stash list | grep "$STASH_NAME" | head -n 1 | cut -d: -f1 || true)
        if [ -n "$STASH_INDEX" ]; then
            git stash pop -q "$STASH_INDEX" || true
        fi
    fi
}
trap restore_stash EXIT

# 5. Run compilation check
echo "⚡ Compiling sources with NullAway and JSpecify checks..."
if $MVN_CMD test-compile -DskipTests -Djacoco.skip=true -Dcheckstyle.skip=true; then
    echo "✅ [PRE-COMMIT] Null-safety checks passed!"
    exit 0
else
    echo ""
    echo "❌ [PRE-COMMIT] NullAway compile failure!"
    echo "💡 Fix the JSpecify @Nullable / NullAway violations shown above before committing."
    echo "💡 (Bypass only in emergencies using: git commit --no-verify)"
    echo ""
    exit 1
fi